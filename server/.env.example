# Copy this file to .env and fill in the values.
# Never put real keys in this file: it is pushed to GitHub. Real keys go in .env only.

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas: Database > Connect > Drivers > copy the connection string
# Add the database name after ".mongodb.net/", e.g. ...mongodb.net/karigor?appName=Cluster0
MONGODB_URI=

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is busy (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Any long random text, used to sign login tokens.
# Make one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cloudinary dashboard: Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
